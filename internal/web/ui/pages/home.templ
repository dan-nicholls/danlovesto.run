package pages

import (
	"fmt"
	"time"
	"math"
	"strconv"
	"github.com/dan-nicholls/danlovesto.run/internal/web/ui/layouts"
	"github.com/dan-nicholls/danlovesto.run/pkg/contracts"
	"strings"
	"net/url"
)

templ Home(info contracts.Info, stats contracts.Summary, hmData contracts.HeatmapData, pbData []contracts.DetailedPersonalBest, mapToken string) {
	@layouts.Base("danlovesto.run") {
		@homeBody(info, stats, hmData, pbData, mapToken)
	}
}

templ homeBody(info contracts.Info, stats contracts.Summary, hmData contracts.HeatmapData, pbData []contracts.DetailedPersonalBest, mapToken string) {
	<main class="page-container">
		@HeadingComponent()
		@SummaryComponent(stats)
		@PBComponent(mapToken, pbData)
		@DailyLog(hmData)
		@FooterComponent(info)
	</main>
}

templ HeadingComponent() {
	<div class="section flexcol">
		<img class="logo" src="/static/img/icon.svg" />
		<h1 class="title">danlovesto.run</h1>
		<sub>I like programming just as much as i do running</sub>
	</div>
}

func commaInt(n int) string {
    s := fmt.Sprintf("%d", n)
    out := ""
    for i, c := range s {
        if i > 0 && (len(s)-i)%3 == 0 {
            out += ","
        }
        out += string(c)
    }
    return out
}

templ SummaryComponent(stats contracts.Summary) {
	<div class="section flexcol">
		<h2>Summary</h2>
		<div class="summary-container">
			<div class="summary-stat">
				<div>{ stats.TotalRuns }</div>
				<div>runs</div>
			</div>
			<div class="summary-stat">
				<div>{ commaInt(int(stats.TotalDistance)) }</div>
				<div>kms</div>
			</div>
			<div class="summary-stat">
				<div>{ stats.TotalHours }</div>
				<div>hours</div>
			</div>
			<div class="summary-stat">
				<div>{ commaInt(int(stats.TotalClimbed )) }</div>
				<div>m climbed</div>
			</div>
		</div>
	</div>
}

func pbAnchorId(distance string) string {
	s := strings.ToLower(strings.TrimSpace(distance))
	s = strings.ReplaceAll(s, " ", "-")
	s = strings.ReplaceAll(s, "_", "-")
	return "pb-" + s
}

templ PBStatComponent(data any, label string) {
	<div class="pb-stat">
		<span class="pb-stat-data">{ fmt.Sprint(data) }</span>
		<span class="pb-stat-label">{ label }</span>
	</div>
}

func mToKmString(m float64) string {
	return fmt.Sprintf("%.1f", m/1000)
}

func formatElapsedTime(s int) string {
	if s <  0 {
		s = 0
	}
	hours := s / 3600
	mins := (s % 3600) / 60
	secs := s % 60

	if hours == 0 {
		return fmt.Sprintf("%d:%02d", mins, secs)
	}
	return fmt.Sprintf("%d:%02d:%d", hours, mins, secs)
}

func mapboxUrl(token string, a contracts.Activity) string {
	polyline := a.Map.SummaryPolyline
	urlTemplate := "https://api.mapbox.com/styles/v1/%s/%s/static/%s/auto/%dx%d?padding=30&access_token=%s"
	username := "mapbox"
	style_id := "light-v11"
	width := 300
	height := 300
	polytest := url.PathEscape(polyline)
	overlay := fmt.Sprintf("path(%s)", polytest)

	url := fmt.Sprintf(urlTemplate, username, style_id, overlay, width, height, token)
	return url
}

templ MapComponent(mapToken string, a *contracts.Activity) {
	if a.Map.SummaryPolyline == "" || mapToken == "" {
		<div class="empty-map">
			<span>No Map data found!</span>
		</div>
		{{ return }}
	}

	<img class="map" src={ mapboxUrl(mapToken, *a) } />
}

templ PBComponent(mapToken string, pbData []contracts.DetailedPersonalBest) {
	<div class="section flexcol">
		<h2>Personal Bests</h2>
		<sub>fastest runs over specific distances</sub>
		if len(pbData) == 0 {
			<div class="section">No personal bests yet. Go for a run!</div>
			return
		}

		<div class="pb-grid" x-data="{ active: 0 }">
			<div class="pb-list">
				<div class="pb-list-headers">
					<span>Name</span>
					<span>Date</span>
					<span>Time</span>
				</div>
				for i, pb := range pbData {
					<div
						class="pb-list-item pb-list-link"
						:class={ "{ 'is-active': active === " + strconv.Itoa(i) + " }" }
						@click={ "active = " + strconv.Itoa(i) }>
						<span><b>{ pb.Name }</b></span>
						<span class="subtitle">{ pb.Activity.StartDateLocal.Format("02 Jan 2006") }</span>
						<span class="subtitle">{ pb.ElapsedTime }</span>
					</div>
				}
			</div>
			<div class="pb-content">
				for i, pb := range pbData {
					<div
						class="pb-panel"
						x-transition.opacity.duration.150ms
						x-cloak
						x-show={ "active === " + strconv.Itoa(i) }>
						<div>
							<div class="pb-details-mini">
								<span class="pb-details-mini-element">{ pb.Activity.ID }</span>
								<span class="pb-details-mini-element">{ pb.Activity.StartDateLocal.Format("02 Jan 2006") }</span>
							</div>
							<h3 class="pb-details-title">{ pb.Activity.Name }</h3>
							<div class="pb-stat-container">
								@PBStatComponent(mToKmString(pb.Activity.Distance), "kilometers")
								@PBStatComponent(formatElapsedTime(pb.Activity.ElapsedTime), "duration")
								@PBStatComponent(fmt.Sprintf("%.2f", pb.Activity.AverageSpeed), "per km")
								@PBStatComponent(pb.Activity.TotalElevationGain, "m climbed")
							</div>
						</div>
					</div>
				}
			</div>
			<div class="pb-map">
				for i, pb := range pbData {
					<div
						x-cloak
						x-show={ "active === "+ strconv.Itoa(i) }>
						@MapComponent(mapToken, pb.Activity)
					</div>
				}
			</div>
		</div>
	</div>
}
 
templ FooterComponent(i contracts.Info) {
	<footer>
		<sub>Version: { i.Version } - Uptime: { i.Uptime }</sub>
	</footer>
}

func getDisabledCells(dateStr string) int {
	t, err := time.Parse("2006-01-02", dateStr); if err != nil {
		return 0
	}
	wd := t.Weekday()
	if wd == time.Sunday {
		return 6
	}
	return int(wd)-1
} 

func intensityGamma(dist, max, gamma float64) float64 {
  if max <= 0 { return 0 }
  if gamma <= 0 { gamma = 1 }
  t := dist / max
  if t < 0 { t = 0 }
  if t > 1 { t = 1 }
  return math.Pow(t, gamma)
}

templ DailyLog(hd contracts.HeatmapData) {
	<div class="heatmap-container">
		<h2>Daily Log</h2>
		<sub>Every day counts.</sub>
		<div>
			for _, y := range hd.Years {
				<div class="heatmap-section">
					<div class="heatmap-header">
						<div class="heatmap-title">{ y.Year }</div>
						<div>{ fmt.Sprintf("%.0f", y.Stats.TotalDistance) } km</div>
						<div>({ fmt.Sprintf("%.2f", y.Stats.AvgDistance) } km/day)</div>
					</div>
					<div class="heatmap-wrapper">
						<div class="y-labels">
							<div class="label">M</div>
							<div class="label">T</div>
							<div class="label">W</div>
							<div class="label">T</div>
							<div class="label">F</div>
							<div class="label">S</div>
							<div class="label">S</div>
						</div>
						<div class="x-labels">
							<div class="x-label">jan</div>
							<div class="x-label">feb</div>
							<div class="x-label">mar</div>
							<div class="x-label">apr</div>
							<div class="x-label">may</div>
							<div class="x-label">jun</div>
							<div class="x-label">jul</div>
							<div class="x-label">aug</div>
							<div class="x-label">sep</div>
							<div class="x-label">oct</div>
							<div class="x-label">nov</div>
							<div class="x-label">dec</div>
						</div>
						<div class={ fmt.Sprintf("heatmap offset-%d", getDisabledCells(y.Days[0].Date))}>
							for _, d := range y.Days {
								<div 
									class={ fmt.Sprintf("cell") }
									style={"--g:" + fmt.Sprintf("%.6f", intensityGamma(d.Distance, hd.Buckets.Domain[1], 0.75 ))}

									data-date={d.Date}
									data-distance={fmt.Sprintf("%.2f", d.Distance)}>
								</div>
							}
						</div>
					</div>
				</div>
			}
		</div>
	</div>
}
